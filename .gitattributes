* text=auto

# Normalize LF for source and docs
*.ino text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.c   text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.js  text eol=lf
*.html text eol=lf
*.json text eol=lf

# Scripts
*.sh  text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
Makefile text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.zip binary
*.7z  binary
*.bin binary
*.elf binary
*.map binary
*.pcb binary
*.sch binary
